# Install as a drop-in for meteormesh-hourly-pull.service.
[Service]
WorkingDirectory=/home/meteor/.local/share/meteormesh/releases/rc158-20261103-analysis-rounds/MeteorHub
Environment=METEORMESH_FAIR_SYNC_ROUND_SIZE=10
ExecStart=
ExecStart=/usr/bin/python3 -B /home/meteor/.local/share/meteormesh/releases/rc158-20261103-analysis-rounds/MeteorHub/meteor_morning.py run --config /home/meteor/.config/meteormesh/devices-three-lab-rc12.json --night-scope /home/meteor/.local/share/meteormesh/staging/fullnight/night-scope-hourly-current.json --data-dir /srv/meteor-data --metdet-repo /opt/meteormesh/MetDetPy --metdet-config /opt/meteormesh/MetDetPy/config/m3det_normal.json --max-jobs 500 --max-runtime-hours 1 --detector-timeout-seconds 1800 --min-free-gb 100 --phase sync
