+# Node 0.10 uses unauthenticated HTTP transport on an isolated laboratory LAN.
+# This special transport is intentionally NOT a replacement for pinned TLS.
+PRIVATE_LAN_RANGES = tuple(ipaddress.ip_network(s) for s in
