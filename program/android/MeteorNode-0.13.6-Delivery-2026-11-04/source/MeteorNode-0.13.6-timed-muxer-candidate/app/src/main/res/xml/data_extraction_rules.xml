<?xml version="1.0" encoding="utf-8"?>
<!-- Meteor footage and pairing keys must not be copied to cloud or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
