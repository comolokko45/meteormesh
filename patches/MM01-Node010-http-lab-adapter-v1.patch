+class MeteorNodeLabHTTP(MeteorNode):
+    """Node 0.10 lab-only transport; inherits the verified, guarded pull logic.
+
+    No insecure HTTP transport is enabled without explicit 'http_lab' config.
+    Never expose port 8080 to the internet; the test bearer token is public.
+    """
+    def __init__(self, host: str, port: int, token: str):
+        require_lab_endpoint(host, port)
+        if len(token) < 32:
+            raise ValueError("Pairing token missing/too short")
+        self.host = host
+        self.port = port
+        self.token = token
+        self.fingerprint = None
+
+    def connection(self) -> http.client.HTTPConnection:
+        return http.client.HTTPConnection(self.host, self.port, timeout=30)
