+
+def require_lab_endpoint(host: str, port: int) -> None:
+    try:
+        address = ipaddress.IPv4Address(host)
+    except ipaddress.AddressValueError as exc:
+        raise ValueError("HTTP lab transport requires a literal RFC1918 IPv4 address") from exc
+    if not any(address in network for network in PRIVATE_LAN_RANGES) or port != 8080:
+        raise ValueError("HTTP lab transport restricted to RFC1918 IPv4 port 8080")
 
 
