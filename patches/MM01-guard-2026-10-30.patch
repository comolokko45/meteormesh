@@ -0,0 +1,92 @@
+"""MM-01: fail-closed protection for the production video/data HDD.
+
+Production root is fixed. Isolated tests may use a fresh /tmp directory only
+with METEORMESH_ISOLATED_TEST_ROOT=isolated-only set explicitly. This flag must
+NEVER be set in any installed systemd service, production shell, or agent.
+"""
+from __future__ import annotations
+
+import os
+import subprocess
+from pathlib import Path
+
+ROOT = Path("/srv/meteor-data")
+UUID = "444a8a6d-090a-456c-8a9d-d99665c32574"
+TEST_FLAG = "METEORMESH_ISOLATED_TEST_ROOT"
+
+
+def _absolute(path: Path) -> Path:
+    return Path(os.path.abspath(os.fspath(path)))
+
+
+def _test_path(root: Path) -> bool:
+    if os.environ.get(TEST_FLAG) != "isolated-only":
+        return False
+    # Exclude /tmp itself; a test may write only under a separate directory.
+    try:
+        relative = root.relative_to(Path("/tmp"))
+        if not relative.parts:
+            return False
+        if root.is_symlink() or Path(os.path.realpath(root)) != root:
+            return False
+        return True
+    except ValueError:
+        return False
+
+
+def ensure_production_root(root: Path) -> None:
+    """Reject any production write when HDD is absent/wrong/readonly.
+
+    Must be called again immediately before each critical write or publication.
+    The systemd mount guard is defense in depth, never a substitute for this.
+    """
+    root = _absolute(root)
+    if root.is_symlink():
+        raise RuntimeError("MOUNT_NOT_VERIFIED: root symlink rejected")
+    if root != ROOT:
+        if _test_path(root):
+            return
+        raise RuntimeError("MOUNT_NOT_VERIFIED: non-production data root forbidden")
+    if not root.is_dir() or not os.path.ismount(root):
+        raise RuntimeError("MOUNT_NOT_VERIFIED: HDD missing, no SSD fallback")
+    try:
+        result = subprocess.run(
+            ["findmnt", "-r", "-n", "-M", str(root), "-o", "TARGET,FSTYPE,UUID"],
+            capture_output=True, text=True, timeout=4, check=False,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise RuntimeError("MOUNT_NOT_VERIFIED: mount identity unavailable") from exc
+    fields = result.stdout.strip().split()
+    if result.returncode != 0 or fields != [str(ROOT), "ext4", UUID]:
+        raise RuntimeError("MOUNT_NOT_VERIFIED: mount UUID/fstype/target mismatch")
+    try:
+        stats = os.statvfs(root)
+    except OSError as exc:
+        raise RuntimeError("MOUNT_NOT_VERIFIED: statvfs failed") from exc
+    if stats.f_flag & getattr(os, "ST_RDONLY", 1):
+        raise RuntimeError("MOUNT_NOT_VERIFIED: filesystem is read-only")
+
+
+def ensure_destination(destination: Path) -> None:
+    """Guard data-root writes, and reject accidental standalone SSD ingest."""
+    destination = _absolute(destination)
+    if destination == ROOT or ROOT in destination.parents:
+        ensure_production_root(ROOT)
+        return
+    if _test_path(destination):
+        return
+    raise RuntimeError("MOUNT_NOT_VERIFIED: output outside verified HDD")
+
+
+def ensure_if_production(path: Path) -> None:
+    """For optional reporting/inspection tools with explicit non-HDD output."""
+    path = _absolute(path)
+    if path == ROOT or ROOT in path.parents:
+        ensure_production_root(ROOT)
+
+
+def prepare_root(root: Path) -> None:
+    """In tests only, allow temporary root creation; NEVER create /srv mountpoint."""
+    ensure_production_root(root)
+    if _test_path(_absolute(root)):
+        root.mkdir(parents=True, exist_ok=True)
--- a/test_storage_guard_mm01.py
+++ b/test_storage_guard_mm01.py
@@ -0,0 +1,96 @@
+"""Negative tests: production HDD identity failure performs no filesystem write."""
+from __future__ import annotations
+import os
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import storage_guard
+from meteormesh_pipeline import database_for
+
+
+class StorageGuardTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix='mm01-isolated-')
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name) / 'hdd'
+        self.root.mkdir()
+        self.patch_root = patch.object(storage_guard, 'ROOT', self.root)
+        self.patch_root.start()
+        self.addCleanup(self.patch_root.stop)
+
+    def response(self, fstype='ext4', uuid=storage_guard.UUID):
+        return subprocess.CompletedProcess(args=[], returncode=0,
+            stdout=f'{self.root} {fstype} {uuid}\n', stderr='')
+
+    def test_absent_mount_fails_without_sqlite(self):
+        with patch('storage_guard.os.path.ismount', return_value=False):
+            with self.assertRaisesRegex(RuntimeError, 'MOUNT_NOT_VERIFIED'):
+                database_for(self.root, initialize=True)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_wrong_uuid_fails_without_sqlite(self):
+        with patch('storage_guard.os.path.ismount', return_value=True), \
+             patch('storage_guard.subprocess.run', return_value=self.response(uuid='incorrect')):
+            with self.assertRaisesRegex(RuntimeError, 'UUID'):
+                database_for(self.root, initialize=True)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_wrong_fstype_fails(self):
+        with patch('storage_guard.os.path.ismount', return_value=True), \
+             patch('storage_guard.subprocess.run', return_value=self.response(fstype='xfs')):
+            with self.assertRaisesRegex(RuntimeError, 'mismatch'):
+                storage_guard.ensure_production_root(self.root)
+
+    def test_malformed_findmnt_fails(self):
+        with patch('storage_guard.os.path.ismount', return_value=True), \
+             patch('storage_guard.subprocess.run', return_value=subprocess.CompletedProcess([], 1,'','')):
+            with self.assertRaisesRegex(RuntimeError, 'MOUNT_NOT_VERIFIED'):
+                database_for(self.root, initialize=True)
+
+    def test_verified_mount_succeeds_using_mock_only(self):
+        with patch('storage_guard.os.path.ismount', return_value=True), \
+             patch('storage_guard.subprocess.run', return_value=self.response()):
+            with database_for(self.root, initialize=True) as db:
+                self.assertEqual(db.execute('SELECT count(*) FROM segments').fetchone()[0], 0)
+        self.assertTrue((self.root / 'meteorhub.sqlite3').is_file())
+
+    def test_guard_fails_when_mount_drops_between_steps(self):
+        responses = iter([True, False])
+        with patch('storage_guard.os.path.ismount', side_effect=lambda *_: next(responses)), \
+             patch('storage_guard.subprocess.run', return_value=self.response()):
+            storage_guard.ensure_production_root(self.root)
+            with self.assertRaisesRegex(RuntimeError, 'MOUNT_NOT_VERIFIED'):
+                storage_guard.ensure_production_root(self.root)
+
+    def test_no_external_root_without_test_flag(self):
+        with patch.dict(os.environ, {storage_guard.TEST_FLAG: ''}):
+            with self.assertRaisesRegex(RuntimeError, 'non-production'):
+                storage_guard.ensure_production_root(Path(self.tmp.name) / 'other')
+
+    def test_temp_root_requires_explicit_test_flag(self):
+        scratch = Path(self.tmp.name) / 'scratch'
+        with patch.dict(os.environ, {storage_guard.TEST_FLAG:'isolated-only'}):
+            storage_guard.prepare_root(scratch)
+            self.assertTrue(scratch.is_dir())
+        with patch.dict(os.environ, {storage_guard.TEST_FLAG: ''}):
+            with self.assertRaisesRegex(RuntimeError, 'non-production'):
+                storage_guard.ensure_production_root(scratch)
+
+    def test_symlink_mount_root_rejected(self):
+        link = Path(self.tmp.name) / 'symlink'
+        link.symlink_to(self.root, target_is_directory=True)
+        storage_guard.ROOT = link
+        with self.assertRaisesRegex(RuntimeError, 'symlink'):
+            storage_guard.ensure_production_root(link)
+
+    def test_destination_outside_hdd_rejected(self):
+        with patch.dict(os.environ, {storage_guard.TEST_FLAG: ''}):
+            with self.assertRaisesRegex(RuntimeError, 'outside verified HDD'):
+                storage_guard.ensure_destination(Path(self.tmp.name) / 'ssd-video.mp4')
+
+
+if __name__ == '__main__':
+    unittest.main()
